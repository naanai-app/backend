# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=place_recommendation
POSTGRES_PORT=5432

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Debug
DEBUG_SEED_DATA=true

# Google Maps API (optional)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# S3 Media
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket
AWS_S3_ENDPOINT_URL=
MEDIA_PRESIGNED_URL_EXPIRE_SECONDS=900

# Recommendation gRPC Service
RECOMMENDATION_GRPC_HOST=localhost
RECOMMENDATION_GRPC_PORT=50051
RECOMMENDATION_GRPC_TIMEOUT_SECONDS=5.0

# Email Configuration (optional)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=Place Recommendation App